# Copy to .env. Values shown here are for local development only.

# Backend
WEATHERIQ_API_KEY=dev-weatheriq-key
# Empty uses <repo>/data/weatheriq.db. Docker Compose sets a PostgreSQL URL.
WEATHERIQ_DATABASE_URL=
WEATHERIQ_CORS_ORIGINS=http://localhost:3000
WEATHERIQ_AUTO_CREATE_SCHEMA=true
WEATHERIQ_HISTORY_DAYS=730
WEATHERIQ_HOURLY_DAYS=21
WEATHERIQ_PREVIOUS_RUN_DAYS=92
WEATHERIQ_REQUEST_TIMEOUT_SECONDS=30

# PostgreSQL (Docker Compose overrides WEATHERIQ_DATABASE_URL)
POSTGRES_USER=weatheriq
POSTGRES_PASSWORD=weatheriq
POSTGRES_DB=weatheriq

# Next.js server-side proxy. Do not prefix the API key with NEXT_PUBLIC.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000/api/v1
WEATHERIQ_API_KEY=dev-weatheriq-key
NEXT_PUBLIC_APP_NAME=WeatherIQ
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
